{
  "name": "web-vitals-distribution",
  "description": "Probability Distribution Utility for Web Vitals",
  "version": "0.4.0",
  "type": "module",
  "typings": "build/index.d.ts",
  "module": "build/index.js",
  "main": "build/index.js",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "license": "MIT",
  "author": "ideamans",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ideamans/web-vitals-distribution.git"
  },
  "homepage": "https://github.com/ideamans/web-vitals-distribution#readme",
  "bugs": {
    "url": "https://github.com/ideamans/web-vitals-distribution/issues"
  },
  "keywords": [
    "web-vitals",
    "core-web-vitals",
    "lcp",
    "inp",
    "cls",
    "ttfb",
    "fcp",
    "fid",
    "rtt",
    "crux",
    "chrome-ux-report",
    "performance",
    "distribution",
    "lognormal",
    "log-normal",
    "probability",
    "statistics",
    "percentile",
    "pdf",
    "cdf"
  ],
  "files": [
    "build",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf build",
    "prebuild": "npm run clean",
    "fix": "run-s fix:*",
    "fix:lint": "eslint --fix",
    "fix:prettier": "prettier --write src",
    "test": "run-s build test:*",
    "test:lint": "eslint src",
    "test:prettier": "prettier src --list-different",
    "test:cspell": "cspell \"{README.md,.github/*.md,src/**/*.ts}\"",
    "test:unit": "nyc --silent ava",
    "watch": "nyc --silent ava --watch",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "ava": "^8.4.0",
    "cspell": "^10.4.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "npm-run-all": "^4.1.5",
    "nyc": "^18.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@stdlib/math-base-special-erf": "^0.2.6",
    "@stdlib/math-base-special-erfinv": "^0.3.1"
  },
  "prettier": {
    "singleQuote": true,
    "semi": false,
    "printWidth": 120
  },
  "resolutions": {
    "**/nyc/glob": "^14.0.4",
    "**/test-exclude/glob": "^14.0.4",
    "**/@vercel/nft/glob": "^14.0.4",
    "**/@typescript-eslint/typescript-estree/glob": "^14.0.4",
    "**/test-exclude/minimatch": "^11.0.5",
    "**/@typescript-eslint/typescript-estree/minimatch": "^11.0.5",
    "**/glob/minimatch": "^11.0.5"
  }
}
